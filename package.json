  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @navarch/web typecheck",
    "test": "vitest run",
    "dev:daemon": "node apps/daemon/src/main.ts",
    "navarch": "node apps/cli/src/main.ts",

{
  "name": "navarch",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @navarch/relay typecheck:phone && pnpm --filter @navarch/web typecheck && pnpm --filter @navarch/site typecheck",
    "build:relay": "pnpm --filter @navarch/relay build:phone",
    "test": "vitest run",
    "dev:daemon": "node apps/daemon/src/main.ts",
    "navarch": "node apps/cli/src/main.ts",
    "build:web": "pnpm --filter @navarch/web build",
    "dev:web": "pnpm --filter @navarch/web dev",
    "build:site": "pnpm --filter @navarch/site build",
    "dev:site": "pnpm --filter @navarch/site dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
